# ---- Servicio ----
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=docker

# ---- Postgres ----
DB_URL=jdbc:postgresql://user-db:5432/user_db
DB_USER=festa_user
DB_PASSWORD=cambiar_en_produccion

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=festa
RABBITMQ_PASS=cambiar_en_produccion

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Auth ----
AUTH_JWKS_URL=http://auth-service:8081/.well-known/jwks.json
AUTH_BASE_URL=http://auth-service:8081

# ---- PII ----
# Generar con scripts/gen-pii-key.sh
PII_ENCRYPTION_KEY=

# ---- Logging ----
LOG_LEVEL=INFO