# Variables de user-service. Con docker compose (festa-infra, perfil "user") se toman de
# festa-infra/.env; este archivo es para correrlo local con `mvn spring-boot:run`.
SERVER_PORT=8082
DB_URL=jdbc:postgresql://localhost:5432/user_db
DB_USER=user_svc
DB_PASSWORD=change-me-user
AMQP_URL=amqp://festa:change-me-rabbit@localhost:5672
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# JWT RS256 de auth-service: se valida con la llave pública que genera festa-infra/scripts/gen-secrets.sh.
JWT_ISSUER=festa-auth
JWT_PUBLIC_KEY_PATH=../festa-infra/secrets/jwt_public.pem
# auth-service, para cambiar el rol al aprobar o rechazar un comercio.
AUTH_BASE_URL=http://localhost:8081

# Obligatoria. openssl rand -base64 32
PII_ENCRYPTION_KEY=

LOG_LEVEL=INFO
