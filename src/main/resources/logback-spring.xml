<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="APP_NAME" value="festa-user-service"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{requestId:-no-req}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.festa.user" level="INFO"/>
    <logger name="org.springframework.amqp" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
</configuration>